# У .gitignore коментар має стояти власним рядком — інакше він стає частиною
# шаблону, і правило мовчки не працює (саме так і сталося з першого разу).

# --- секрети ---
.env.*
!.env.*.example

# --- персональні дані ---
# повний архів розмов
memory/sessions.db
memory/sessions.db-journal
# закріплені факти про користувача
memory/facts/
# екстракти з інших проєктів
memory/import/
# модель ембедінгів, 240 МБ
memory/models/
# задачі
tasks/tasks.jsonl
tasks/open.md
# журнал дій: у командах трапляються шляхи й ключі
changelog/*.jsonl
# стан вартового, останній UID пошти
status/state/
# кеш пробників із вмістом листів і подій
status/cache/
# згенеровані дайджести і звіти
status/digest-*.txt
reports/

# --- оточення й сміття ---
.venv-voice/
__pycache__/
*.pyc
*.bak
*.tmp
# конфіг із реальним id календаря
tasks/config.json
