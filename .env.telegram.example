# Telegram bots. Mode 600; the real file is git-ignored.
#
# The main bot is the conversational one — the session polls it and answers there.
TELEGRAM_BOT_TOKEN=123456:AA...
TELEGRAM_CHAT_ID=100000000

# Named one-way broadcast bots, mapped in config.json (`telegram.bots`: kind → suffix).
# `notify.sh --bot mood "…"` sends through TELEGRAM_BOT_TOKEN_ZIRKA and falls back to the
# main bot when the token is absent. Nothing polls getUpdates for these, so a reply sent
# to one of them never reaches the session.
#
# The chat id is the same personal chat unless overridden, but each bot must be started
# once (/start in its chat) before it is allowed to write.

# bot Zirka: the morning horoscope, spoken by Зоря
TELEGRAM_BOT_TOKEN_ZIRKA=123456:AA...
#TELEGRAM_CHAT_ID_ZIRKA=100000000

# bot Bruno: the digest's news section and the YouTube picks, both spoken by Бруно
TELEGRAM_BOT_TOKEN_BRUNO=123456:AA...
#TELEGRAM_CHAT_ID_BRUNO=100000000
