# One-time OAuth to read your own YouTube subscriptions (t1040). Mode 600, git-ignored.
# Create a Desktop OAuth client in Google Cloud (YouTube Data API v3 enabled), then run
# status/tools/youtube_oauth.py once — it fills YT_REFRESH_TOKEN after you approve in a browser.
YT_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
YT_CLIENT_SECRET=xxxxxxxx
YT_REFRESH_TOKEN=
