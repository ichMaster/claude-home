# Секретні iCal-адреси календарів: Google Календар → налаштування конкретного
# календаря → «Інтеграція календаря» → «Секретна адреса в форматі iCal».
# По рядку на календар, назва після CAL_ потрапляє у вивід пробника.
#   cp .env.calendar.example .env.calendar && chmod 600 .env.calendar
CAL_особистий=
CAL_сімейні=
